{
  "name": "@dungeon/bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "commands:register": "node --env-file-if-exists=.env --import tsx src/register-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}