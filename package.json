{
  "name": "dungeon-crew",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @dungeon/web dev",
    "dev:bot": "pnpm --filter @dungeon/bot dev",
    "dev:bot:pass": "pass-cli run --env-file .env.pass -- pnpm dev:bot",
    "bot:register:pass": "pass-cli run --env-file .env.pass -- pnpm --filter @dungeon/bot commands:register",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
